NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

DATABASE_URL=postgresql://langa:5638@localhost:5432/leafy

# Google OAuth credentials (get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Configure when implementing the Daraja payment module.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Optional provider credentials; the corresponding integrations are not enabled yet.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
