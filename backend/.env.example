NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Configure these from the Supabase project dashboard. Never use a real value in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Configure when implementing the Daraja payment module.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Optional provider credentials; the corresponding integrations are not enabled yet.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
