{
  "name": "backend",
  "version": "1.0.0",
  "description": "Leafy versioned API",
  "private": true,
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "leafy",
    "api"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "vitest": "^4.1.12"
  }
}
